# ussdgw container env — 5k TPS profile (capacity_5k_tps.md §5–§6).
# Container budget: 16 CPUs / 64 GiB. Consumed by stack.capacity-5k.yml (env_file) → run.sh.
#
# Precedence reminder: env (ordinal 300) beats configs/application.properties (260), but a value
# saved in the admin UI RuntimeConfigStore (DB) beats both for its keys — verify /admin/http and
# /admin/bridge after deploy. BUILD_TIME keys (microjainslee.container.*) are NOT settable here.

# ── Heap (run.sh reads these) ────────────────────────────────────────────────
USSD_XMS=40g
USSD_XMX=40g
USSD_ALWAYS_PRETOUCH=1
USSD_LOG_DIR=/opt/ussdgw/logs

# ── JVM flags appended by run.sh after its defaults (later -XX wins) ─────────
JAVA_OPTS=-XX:SoftMaxHeapSize=34g -XX:ConcGCThreads=4 -XX:+UseTransparentHugePages -XX:ActiveProcessorCount=16 -Djdk.virtualThreadScheduler.parallelism=16 -Djdk.virtualThreadScheduler.maxPoolSize=256 -XX:MaxDirectMemorySize=6g -XX:MaxMetaspaceSize=1g -XX:ReservedCodeCacheSize=512m -XX:NativeMemoryTracking=summary -Xlog:gc*,safepoint:file=/opt/ussdgw/logs/gc.log:time,uptime,level,tags:filecount=10,filesize=100m -XX:HeapDumpPath=/opt/ussdgw/dumps -Dlog4j2.asyncLoggerRingBufferSize=262144 -Dlog4j2.asyncQueueFullPolicy=Default -Dmicrojainslee.container.offheap-storage-dir=/opt/ussdgw/data/offheap -Dussd.log.max-size=1GB

# ── Runtime property overrides (Quarkus env-name mapping) ─────────────────────
HTTP_RA_WORKER_POOL_SIZE=512
HTTP_RA_EVENT_LOOP_THREADS=8
USSD_HTTP_CLIENT_MAX_POOL_SIZE=12288
USSD_HTTP_CLIENT_REQUEST_TIMEOUT_MS=10000
USSD_HTTP_CLIENT_CONNECT_TIMEOUT_MS=3000
USSD_CDR_RECENT_EVENTS=2000000
USSD_CDR_DB_ENABLED=false
QUARKUS_DATASOURCE_JDBC_MAX_SIZE=48
QUARKUS_DATASOURCE_JDBC_MIN_SIZE=8
USSD_BRIDGE_GATE_TICK_MS=100

# New keys — only effective after the code changes land (capacity_5k_tps.md §4):
USSD_HTTP_CLIENT_MAX_WAIT_QUEUE_SIZE=20000
USSD_TX_MAX_SESSION_MS=600000
USSD_USER_PROFILE_TTL_MS=3600000
USSD_USER_MAX_PROFILES=2000000
