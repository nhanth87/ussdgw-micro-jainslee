# ussdgw on the PRODUCTION host (30 CPU / 128 GB) — read by docker/capacity/stack.prod.yml.
# Heap and the SLEE log level are set in the overlay's `environment:` (they must beat the base
# stack's `environment:`); everything here is not set by the base stack.

# Pre-touch the 40 GB heap at start: no page-fault stalls under load (start takes ~10-20 s longer).
USSD_ALWAYS_PRETOUCH=1

# JVM: ZGC (run.sh), sized to the 20-CPU limit. Virtual threads carry the SBB work, so their
# scheduler gets one carrier per CPU.
JAVA_OPTS=-XX:SoftMaxHeapSize=34g -XX:ConcGCThreads=4 -XX:+UseTransparentHugePages -XX:ActiveProcessorCount=20 -Djdk.virtualThreadScheduler.parallelism=20 -Djdk.virtualThreadScheduler.maxPoolSize=256 -XX:MaxDirectMemorySize=8g -XX:MaxMetaspaceSize=1g -XX:ReservedCodeCacheSize=512m -XX:NativeMemoryTracking=summary -Xlog:gc*,safepoint:file=/opt/ussdgw/logs/gc.log:time,uptime,level,tags:filecount=10,filesize=100m -XX:HeapDumpPath=/opt/ussdgw/logs -Dlog4j2.asyncLoggerRingBufferSize=262144 -Dussd.log.max-size=1GB

# HTTP client RA (AS pulls): one entity per CPU (ra-instances 0 = ActiveProcessorCount = 20),
# 12288 connections shared between them (~614 each). The AS gets 30 s per pull (enforced in
# code), so a slow AS at 10k TPS needs this many connections in flight.
USSD_HTTP_CLIENT_MAX_POOL_SIZE=12288
USSD_HTTP_CLIENT_RA_INSTANCES=0

# HTTP server RA (admin UI, AS callbacks, classic NI push).
HTTP_RA_EVENT_LOOP_THREADS=8
HTTP_RA_WORKER_POOL_SIZE=512

# PostgreSQL pool (config, routing, tenants — CDRs are in ClickHouse).
QUARKUS_DATASOURCE_JDBC_MAX_SIZE=96
QUARKUS_DATASOURCE_JDBC_MIN_SIZE=16

# In-memory recent-CDR ring for the admin UI, and the longest a USSD session may live.
USSD_CDR_RECENT_EVENTS=500000
USSD_TX_MAX_SESSION_MS=600000
