<clickhouse>
    <!-- Logs go to the container console (json-file, rotated by Docker); no files to fill /var/log. -->
    <logger>
        <level>warning</level>
        <console>1</console>
        <log remove="remove"/>
        <errorlog remove="remove"/>
    </logger>

    <!-- Only HTTP (8123, the gateway) and native TCP (9000, clickhouse-client / initdb) stay. -->
    <mysql_port remove="remove"/>
    <postgresql_port remove="remove"/>
    <interserver_http_port remove="remove"/>

    <!-- Sized for a 15 GiB host shared with ussdgw (6 GiB) and PostgreSQL (1 GiB).
         The server also honours the container memory limit (cgroup). -->
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>134217728</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

    <!-- System log tables grow without bound by default. Keep a week of query_log for
         diagnosis; drop the high-volume ones. -->
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <trace_log remove="remove"/>
    <text_log remove="remove"/>
    <metric_log remove="remove"/>
    <query_metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <latency_log remove="remove"/>
    <error_log remove="remove"/>
    <processors_profile_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <query_views_log remove="remove"/>
    <part_log remove="remove"/>
    <session_log remove="remove"/>
    <opentelemetry_span_log remove="remove"/>
    <asynchronous_insert_log remove="remove"/>
    <backup_log remove="remove"/>
    <blob_storage_log remove="remove"/>
    <background_schedule_pool_log remove="remove"/>
</clickhouse>
